{
  "name": "atreyu",
  "version": "1.3.0",
  "type": "module",
  "description": "Frame.io marketing site on AEM Edge Delivery Services",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "lint:js": "eslint .",
    "lint:css": "stylelint blocks/**/*.css styles/*.css experiments-panel/*.css",
    "lint:css-layers": "node tools/lint-css-layers.mjs",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:css-layers && npm run lint:comments",
    "test:eslint-rules": "node tools/check-comments.test.mjs && node tools/eslint-rules/config-drift.test.js",
    "test:stylelint-rules": "node tools/stylelint-rules/z-index-requires-token.test.js",
    "test:config-sync": "node tools/config-sync/locales.test.js && node tools/config-sync/panel-no-ak.test.js && node tools/config-sync/experiment-graph.test.js",
    "test:locale-extractor": "node tools/locale-extractor/extractor.test.js",
    "locale-extractor": "node tools/locale-extractor/cli.js",
    "test": "wtr \"./test/**/*.test.(js|html)\" --coverage --concurrent-browsers 4 --concurrency 2",
    "test:watch": "npm test -- --watch",
    "test:file": "wtr --coverage --concurrency 2",
    "test:file:watch": "wtr --coverage --concurrency 2 --watch",
    "build:lit": "esbuild --format=esm --minify ./scripts/vendor/lit/src/index.js --bundle --outfile=./scripts/vendor/lit/dist/index.js",
    "lint:comments": "node tools/check-comments.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dallinbsmith/atreyu.git"
  },
  "author": "Adobe",
  "license": "Apache License 2.0",
  "bugs": {
    "url": "https://github.com/dallinbsmith/atreyu/issues"
  },
  "homepage": "https://github.com/dallinbsmith/atreyu#readme",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@adobe/eslint-config-helix": "^3.0.32",
    "@esm-bundle/chai": "4.3.4-fix.0",
    "@web/dev-server-import-maps": "^0.3.0",
    "@web/test-runner": "^0.18.0",
    "@web/test-runner-commands": "1.0.1",
    "chai": "6.2.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.2",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-prefer-arrow-functions": "^3.10.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^65.0.1",
    "espree": "^11.2.0",
    "globals": "^16.0.0",
    "lit": "^3.3.3",
    "sinon": "^21.0.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1"
  }
}
